generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id                       String                    @id @default(uuid())
  name                     String
  email                    String                    @unique
  password                 String
  role                     String                    @default("agent")
  mobile                   String?
  status                   String                    @default("offline")
  isActive                 Boolean                   @default(true)
  avatar                   String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  activityLogs             ActivityLog[]             @relation("ActivityActor")
  chats                    Chat[]                    @relation("AgentChats")
  assignedClients          Client[]                  @relation("AssignedAgent")
  assignmentsGiven         CustomerAssignment[]      @relation("AssignmentActor")
  assignmentsReceived      CustomerAssignment[]      @relation("AssignmentEmployee")
  assignedFollowUps        FollowUp[]                @relation("FollowUpAssignee")
  completedFollowUps       FollowUp[]                @relation("FollowUpCompleter")
  sentFollowUps            FollowUp[]                @relation("FollowUpSender")
  notifications            Notification[]
  passwordReset            PasswordReset?
  payments                 Payment[]
  createdPurchases         Purchase[]                @relation("PurchaseCreator")
  refreshTokens            RefreshToken[]
  scheduledCalls           ScheduledCall[]
  sessions                 Session[]
  subscriptions            Subscription[]
  whatsAppConversations    WhatsAppConversation[]    @relation("WhatsAppConversations")
  whatsAppPhoneAssignments WhatsAppPhoneAssignment[] @relation("WhatsAppPhoneAssignments")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  agentId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  agentId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Visitor {
  id         String   @id @default(uuid())
  name       String?
  email      String?
  status     String   @default("online")
  metadata   String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  chats      Chat[]
}

model Chat {
  id                String    @id @default(uuid())
  visitorId         String
  clientId          String?
  agentId           String?
  status            String    @default("waiting")
  conversationState String    @default("AI_ACTIVE")
  subject           String?
  tags              String    @default("")
  unreadCount       Int       @default(0)
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  agent             Agent?    @relation("AgentChats", fields: [agentId], references: [id])
  client            Client?   @relation(fields: [clientId], references: [id])
  visitor           Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@index([status])
  @@index([agentId])
  @@index([visitorId])
  @@index([clientId])
  @@index([conversationState])
  @@index([agentId, status])
  @@index([clientId, status])
  @@index([updatedAt])
}

model Message {
  id          String       @id @default(uuid())
  chatId      String
  senderId    String
  senderType  String
  senderName  String?
  content     String       @default("")
  status      String       @default("sent")
  replyTo     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]
  chat        Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  replyToMsg  Message?     @relation("MessageReply", fields: [replyTo], references: [id])
  replies     Message[]    @relation("MessageReply")

  @@index([chatId])
  @@index([senderId])
}

model Attachment {
  id           String   @id @default(uuid())
  messageId    String
  url          String
  thumbnailUrl String?
  fileName     String
  fileSize     Int
  mimeType     String
  type         String
  duration     Int?
  createdAt    DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model AdminStats {
  id                 String   @id @default(uuid())
  date               DateTime @unique @default(now())
  totalVisitors      Int      @default(0)
  activeChats        Int      @default(0)
  closedChatsToday   Int      @default(0)
  onlineAgents       Int      @default(0)
  totalMessages      Int      @default(0)
  storageUsedMB      Float    @default(0)
  avgResponseTimeSec Int      @default(0)
  satisfactionRate   Int      @default(0)
}

model OTP {
  id            String    @id @default(uuid())
  phone         String    @unique
  expiresAt     DateTime
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  attempts      Int       @default(0)
  ipAddress     String?
  lastAttemptAt DateTime?
  maxAttempts   Int       @default(5)
  otpHash       String
  userAgent     String?
}

model PasswordReset {
  id        String   @id @default(uuid())
  agentId   String   @unique
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Client {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String?                @unique
  phone                 String?                @unique
  city                  String?
  plan                  String                 @default("Starter")
  status                String                 @default("Active")
  source                String?                @default("Direct")
  notes                 String?
  totalChats            Int                    @default(0)
  satisfaction          Int                    @default(0)
  currentLeadStatus     String                 @default("NEW")
  assignedEmployeeId    String?
  externalPlatformId    String?                @unique
  joined                DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  activityLogs          ActivityLog[]
  chatThreads           Chat[]
  assignedEmployee      Agent?                 @relation("AssignedAgent", fields: [assignedEmployeeId], references: [id])
  assignments           CustomerAssignment[]
  followUps             FollowUp[]
  followUpCycles        FollowUpCycle[]
  purchases             Purchase[]
  scheduledCalls        ScheduledCall[]
  smsLogs               SmsLog[]
  whatsAppConversations WhatsAppConversation[]

  @@index([phone])
  @@index([currentLeadStatus])
  @@index([assignedEmployeeId])
  @@index([status])
  @@index([plan])
  @@index([city])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  agentId   String?
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  metadata  String?
  createdAt DateTime @default(now())
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([read])
  @@index([createdAt])
}

model Purchase {
  id             String         @id @default(uuid())
  clientId       String
  purchaseAmount Float
  productDetails String?
  purchaseDate   DateTime       @default(now())
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  followUpCycle  FollowUpCycle?
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy      Agent?         @relation("PurchaseCreator", fields: [createdById], references: [id])

  @@index([clientId])
  @@index([purchaseDate])
  @@index([clientId, purchaseDate])
}

model FollowUpCycle {
  id              String     @id @default(uuid())
  clientId        String
  purchaseId      String     @unique
  status          String     @default("ACTIVE")
  cancelledReason String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  followUps       FollowUp[]
  client          Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  purchase        Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
}

model FollowUp {
  id                 String        @id @default(uuid())
  cycleId            String
  clientId           String
  purchaseId         String
  followUpNumber     Int
  scheduledDate      DateTime
  status             String        @default("PENDING")
  assignedEmployeeId String?
  notes              String?
  completedAt        DateTime?
  completedById      String?
  sentAt             DateTime?
  sentById           String?
  error              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  assignedEmployee   Agent?        @relation("FollowUpAssignee", fields: [assignedEmployeeId], references: [id])
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  completedBy        Agent?        @relation("FollowUpCompleter", fields: [completedById], references: [id])
  cycle              FollowUpCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  sentBy             Agent?        @relation("FollowUpSender", fields: [sentById], references: [id])
  smsLogs            SmsLog[]

  @@index([clientId])
  @@index([scheduledDate])
  @@index([status])
  @@index([assignedEmployeeId])
  @@index([clientId, status, scheduledDate])
  @@index([assignedEmployeeId, status, scheduledDate])
}

model ActivityLog {
  id           String   @id @default(uuid())
  clientId     String?
  userId       String?
  activityType String
  description  String
  metadata     String?
  createdAt    DateTime @default(now())
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         Agent?   @relation("ActivityActor", fields: [userId], references: [id])

  @@index([clientId])
  @@index([activityType])
  @@index([createdAt])
}

model CustomerAssignment {
  id           String    @id @default(uuid())
  clientId     String
  employeeId   String
  assignedById String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  assignedBy   Agent?    @relation("AssignmentActor", fields: [assignedById], references: [id])
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee     Agent     @relation("AssignmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([employeeId])
}

model SmsLog {
  id         String    @id @default(uuid())
  to         String
  body       String
  status     String
  sid        String?
  error      String?
  type       String?
  clientId   String?
  followUpId String?
  sentAt     DateTime  @default(now())
  client     Client?   @relation(fields: [clientId], references: [id])
  followUp   FollowUp? @relation(fields: [followUpId], references: [id])

  @@index([clientId])
  @@index([followUpId])
  @@index([status])
  @@index([sentAt])
}

model WhatsAppConversation {
  id                   String                 @id @default(uuid())
  ownerAgentId         String
  clientId             String?
  remotePhone          String
  remoteName           String?
  remoteAvatarUrl      String?
  lastMessageAt        DateTime               @default(now())
  lastMessagePreview   String?
  lastMessageDirection String?
  unreadCount          Int                    @default(0)
  status               String                 @default("OPEN")
  phoneNumberId        String?
  isUnassigned         Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  client               Client?                @relation(fields: [clientId], references: [id])
  ownerAgent           Agent                  @relation("WhatsAppConversations", fields: [ownerAgentId], references: [id], onDelete: Cascade)
  messages             WhatsAppMessage[]
  webhookEvents        WhatsAppWebhookEvent[]

  @@unique([ownerAgentId, remotePhone])
  @@index([ownerAgentId])
  @@index([clientId])
  @@index([remotePhone])
  @@index([lastMessageAt])
  @@index([status])
  @@index([isUnassigned])
  @@index([phoneNumberId])
}

model WhatsAppMessage {
  id                String               @id @default(uuid())
  conversationId    String
  direction         String
  type              String               @default("text")
  body              String?
  mediaUrl          String?
  mediaMimeType     String?
  status            String               @default("PENDING")
  whatsappMessageId String?              @unique
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime             @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  conversation      WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([status])
  @@index([whatsappMessageId])
  @@index([sentAt])
}

model WhatsAppWebhookEvent {
  id               String                @id @default(uuid())
  payload          String
  conversationId   String?
  type             String
  dedupKey         String?               @unique
  processingStatus String                @default("received")
  processingError  String?
  receivedAt       DateTime              @default(now())
  conversation     WhatsAppConversation? @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([type])
  @@index([receivedAt])
}

model WhatsAppPhoneAssignment {
  id            String   @id @default(uuid())
  phoneNumberId String   @unique
  ownerAgentId  String
  label         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ownerAgent    Agent    @relation("WhatsAppPhoneAssignments", fields: [ownerAgentId], references: [id], onDelete: Cascade)

  @@index([ownerAgentId])
}

model ScheduledCall {
  id                 String   @id @default(uuid())
  clientId           String
  assignedEmployeeId String?
  phone              String
  scheduledDate      DateTime
  notes              String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  assignedEmployee   Agent?   @relation(fields: [assignedEmployeeId], references: [id])
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([assignedEmployeeId])
  @@index([scheduledDate])
}

model Subscription {
  id              String    @id @default(uuid())
  planId          String
  planName        String
  status          String    @default("active")
  amount          Float
  currency        String    @default("INR")
  interval        String    @default("month")
  startedAt       DateTime  @default(now())
  expiresAt       DateTime?
  autoRenew       Boolean   @default(false)
  canceledAt      DateTime?
  paymentProvider String?
  providerPlanId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  agentId         String
  payments        Payment[]
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
}

model Payment {
  id                String        @id @default(uuid())
  subscriptionId    String?
  amount            Float
  currency          String        @default("INR")
  status            String        @default("pending")
  paymentMethod     String?
  provider          String?
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  receiptUrl        String?
  errorMessage      String?
  metadata          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  agentId           String
  agent             Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([agentId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
}
