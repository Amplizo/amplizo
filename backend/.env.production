# Production Environment Variables for Amplizo Backend
# Copy this to .env.production.local and fill with real values
# DO NOT commit .env.production.local to version control

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/amplizo?schema=public"

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET="GENERATE_RANDOM_64_CHAR_STRING_WITH_openssl_rand_base64_64"
JWT_EXPIRES_IN="15m"

# ============================================
# SERVER
# ============================================
PORT=4000
FRONTEND_URL="https://amplizo.com"
NODE_ENV="production"

# ============================================
# CORS & PROXY
# ============================================
ALLOWED_ORIGINS="https://amplizo.com,https://www.amplizo.com,https://admin.amplizo.com"
ALLOWED_WS_ORIGINS="https://amplizo.com,https://www.amplizo.com"
TRUST_PROXY=1

# ============================================
# AUTH & SECURITY
# ============================================
OTP_PEPPER="separate-random-64-char-string"
WHATSAPP_VERIFY_TOKEN="your-whatsapp-webhook-verify-token"
BUSINESS_NAME="Amplizo"
SWAGGER_ENABLED="false"

# ============================================
# OAuth - Google (optional)
# ============================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://api.amplizo.com/api/auth/google/callback"

# ============================================
# OAuth - Facebook (optional)
# ============================================
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CALLBACK_URL="https://api.amplizo.com/api/auth/facebook/callback"

# ============================================
# SMS (Twilio) - Required for OTP login
# ============================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
SMS_MODE="production"

# ============================================
# Email (SMTP) - Required for password reset
# ============================================
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@amplizo.com"

# ============================================
# Redis (Optional - for job queues)
# ============================================
REDIS_URL=""
REDIS_ENABLED="true"

# ============================================
# AWS S3 (Optional - for file uploads)
# ============================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="amplizo-uploads"
AWS_S3_REGION="ap-south-1"

# ============================================
# Sentry (Optional - error tracking)
# ============================================
SENTRY_DSN=""

# ============================================
# Payment Provider (razorpay | stripe | none)
# ============================================
PAYMENT_PROVIDER="razorpay"

# ============================================
# Razorpay (Required for payments)
# ============================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ============================================
# Stripe (Alternative to Razorpay)
# ============================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ============================================
# WhatsApp Business Cloud API (optional)
# ============================================
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# NOTE: Ensure WHATSAPP_VERIFY_TOKEN above is set to a strong random value
# (it is required at startup in production). When adding a new WhatsApp phone
# number to Meta's webhook config, use this same token as the verify token.
